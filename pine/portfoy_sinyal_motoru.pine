//@version=6
// =============================================================================
// Portföy Paneli — Sinyal Motoru
//
// Bu betik, panelin `indikator.py` dosyasındaki kural motorunun TradingView
// karşılığıdır. Aynı göstergeler, aynı varsayılan eşikler, aynı puanlama:
// böylece grafikte gördüğün sinyalle panelde gördüğün sinyal tutar. İki ayrı
// sistem iki ayrı şey söylerse ikisine de güvenemezsin.
//
// Panelin yapamadığı tek şeyi yapar: alarmlar TradingView'in sunucusunda
// çalışır, yani bilgisayarın kapalıyken de bildirim gelir.
//
// Tek indikatör yuvası kullanır (ücretsiz TradingView hesabında grafik başına
// indikatör sayısı sınırlıdır). Bu yüzden RSI ve MACD ayrı pencerelere
// çizilmez; değerleri sağ üstteki özet tablosunda okunur.
//
// YATIRIM TAVSİYESİ DEĞİLDİR. Puan, senin tanımladığın kuralların sayımıdır.
// =============================================================================

indicator("Portföy Paneli — Sinyal Motoru", shorttitle="PPS", overlay = true)

// --- Girdiler ---------------------------------------------------------------
grupRsi = "RSI"
rsiPeriyot  = input.int(14,  "Periyot",          minval = 2, group = grupRsi)
rsiAsiriSat = input.float(30, "Aşırı satım eşiği", group = grupRsi)
rsiAsiriAl  = input.float(70, "Aşırı alım eşiği",  group = grupRsi)

grupMacd = "MACD"
macdHizli     = input.int(12, "Hızlı EMA", minval = 1, group = grupMacd)
macdYavas     = input.int(26, "Yavaş EMA", minval = 1, group = grupMacd)
macdSinyalLen = input.int(9,  "Sinyal",    minval = 1, group = grupMacd)

grupMa = "Hareketli ortalamalar"
smaKisa = input.int(50,  "Kısa SMA", minval = 1, group = grupMa)
smaUzun = input.int(200, "Uzun SMA", minval = 1, group = grupMa)

grupBb = "Bollinger"
bbPeriyot = input.int(20,     "Periyot",       minval = 2, group = grupBb)
bbSapma   = input.float(2.0,  "Standart sapma", step = 0.1, group = grupBb)
bbAltEsik = input.float(0.05, "%B alt eşik",    step = 0.01, group = grupBb)
bbUstEsik = input.float(0.95, "%B üst eşik",    step = 0.01, group = grupBb)

grupGenel = "Genel"
// Panelin `kesisim()` fonksiyonu da son 5 bara bakar. Yalnızca içinde
// bulunulan bara bakmak, günde bir kez grafiğe bakıldığında kesişimlerin
// çoğunu kaçırır.
bakilacakBar = input.int(5, "Kesişim penceresi (bar)", minval = 1, group = grupGenel)
tabloGoster  = input.bool(true, "Özet tabloyu göster",  group = grupGenel)
bantGoster   = input.bool(true, "Bollinger bantlarını çiz", group = grupGenel)

// --- Göstergeler ------------------------------------------------------------
// ta.rsi Wilder yumuşatması (RMA) kullanır — panelin wilder_rsi'ı ile aynı.
rsi = ta.rsi(close, rsiPeriyot)

[macdCizgi, macdSinyalCizgi, macdHist] = ta.macd(close, macdHizli, macdYavas, macdSinyalLen)

smaHizliSeri = ta.sma(close, smaKisa)
smaYavasSeri = ta.sma(close, smaUzun)

// ta.bb popülasyon standart sapması kullanır — panelin ddof=0 tercihiyle aynı.
[bbOrta, bbUst, bbAlt] = ta.bb(close, bbPeriyot, bbSapma)
bbGenislik = bbUst - bbAlt
yuzdeB = bbGenislik > 0 ? (close - bbAlt) / bbGenislik : na

// --- Kesişimler -------------------------------------------------------------
// barssince hiç gerçekleşmemişse na döner; nz ile çok büyük bir sayıya
// çevrilir, böylece "hiç kesişmedi" ile "az önce kesişti" karışmaz.
ULASILMAZ = 999999
macdYukariBar = nz(ta.barssince(ta.crossover(macdCizgi, macdSinyalCizgi)),  ULASILMAZ)
macdAsagiBar  = nz(ta.barssince(ta.crossunder(macdCizgi, macdSinyalCizgi)), ULASILMAZ)
maYukariBar   = nz(ta.barssince(ta.crossover(smaHizliSeri, smaYavasSeri)),  ULASILMAZ)
maAsagiBar    = nz(ta.barssince(ta.crossunder(smaHizliSeri, smaYavasSeri)), ULASILMAZ)

macdYukari = macdYukariBar <= bakilacakBar
macdAsagi  = macdAsagiBar  <= bakilacakBar
maYukari   = maYukariBar   <= bakilacakBar
maAsagi    = maAsagiBar    <= bakilacakBar

// --- Kurallar ---------------------------------------------------------------
// Panelin VARSAYILAN_KURALLAR listesiyle birebir aynı sekiz kural.
// `not na(...)` koşulları, panelin "veri yoksa tetiklenmez" davranışını
// yansıtır: hesaplanamayan gösterge sinyal üretmez.
kuralRsiSat  = not na(rsi) and rsi < rsiAsiriSat        // AL
kuralRsiAl   = not na(rsi) and rsi > rsiAsiriAl         // SAT
kuralMacdYuk = macdYukari                               // AL
kuralMacdAsg = macdAsagi                                // SAT
kuralMaYuk   = maYukari                                 // AL
kuralMaAsg   = maAsagi                                  // SAT
kuralBbAlt   = not na(yuzdeB) and yuzdeB < bbAltEsik    // AL
kuralBbUst   = not na(yuzdeB) and yuzdeB > bbUstEsik    // SAT

alSayisi  = (kuralRsiSat ? 1 : 0) + (kuralMacdYuk ? 1 : 0) + (kuralMaYuk ? 1 : 0) + (kuralBbAlt ? 1 : 0)
satSayisi = (kuralRsiAl  ? 1 : 0) + (kuralMacdAsg ? 1 : 0) + (kuralMaAsg ? 1 : 0) + (kuralBbUst ? 1 : 0)
puan = alSayisi - satSayisi

etiket = puan > 0 ? "AL yönlü" : puan < 0 ? "SAT yönlü" : "Nötr"

// Yön değişimi: işaret ve alarm bunun üzerine kurulur. Puanın pozitif kaldığı
// her barda değil, pozitife GEÇTİĞİ barda tetiklenir — aksi hâlde grafik
// işaretle dolar ve alarm sürekli çalar.
alYonuneGecti  = puan > 0 and puan[1] <= 0
satYonuneGecti = puan < 0 and puan[1] >= 0

// --- Çizimler ---------------------------------------------------------------
plot(smaHizliSeri, "SMA kısa", color = color.new(color.orange, 0), linewidth = 1)
plot(smaYavasSeri, "SMA uzun", color = color.new(color.blue, 0),   linewidth = 2)

bbUstCizgi = plot(bantGoster ? bbUst  : na, "BB üst",  color = color.new(color.gray, 55))
bbAltCizgi = plot(bantGoster ? bbAlt  : na, "BB alt",  color = color.new(color.gray, 55))
plot(bantGoster ? bbOrta : na, "BB orta", color = color.new(color.gray, 70))
fill(bbUstCizgi, bbAltCizgi, color = color.new(color.gray, 92), title = "BB dolgu")

plotshape(alYonuneGecti,  title = "AL yönüne geçti",  style = shape.triangleup,
          location = location.belowbar, color = color.new(color.green, 0),
          size = size.tiny, text = "AL")
plotshape(satYonuneGecti, title = "SAT yönüne geçti", style = shape.triangledown,
          location = location.abovebar, color = color.new(color.red, 0),
          size = size.tiny, text = "SAT")

// --- Özet tablosu -----------------------------------------------------------
var table ozet = table.new(position.top_right, 2, 7, border_width = 1)

if tabloGoster and barstate.islast
    puanRengi = puan > 0 ? color.new(color.green, 80) : puan < 0 ? color.new(color.red, 80) : color.new(color.gray, 80)

    table.cell(ozet, 0, 0, "Gösterge", bgcolor = color.new(color.gray, 60), text_size = size.small)
    table.cell(ozet, 1, 0, "Değer",    bgcolor = color.new(color.gray, 60), text_size = size.small)

    table.cell(ozet, 0, 1, "RSI(" + str.tostring(rsiPeriyot) + ")", text_size = size.small)
    table.cell(ozet, 1, 1, na(rsi) ? "N/A" : str.tostring(rsi, "#.#"), text_size = size.small)

    table.cell(ozet, 0, 2, "MACD hist.", text_size = size.small)
    table.cell(ozet, 1, 2, na(macdHist) ? "N/A" : str.tostring(macdHist, "#.###"), text_size = size.small)

    table.cell(ozet, 0, 3, "Bollinger %B", text_size = size.small)
    table.cell(ozet, 1, 3, na(yuzdeB) ? "N/A" : str.tostring(yuzdeB, "#.##"), text_size = size.small)

    table.cell(ozet, 0, 4, "Fiyat > SMA" + str.tostring(smaUzun), text_size = size.small)
    table.cell(ozet, 1, 4, na(smaYavasSeri) ? "N/A" : (close > smaYavasSeri ? "evet" : "hayır"), text_size = size.small)

    table.cell(ozet, 0, 5, "AL / SAT", text_size = size.small)
    table.cell(ozet, 1, 5, str.tostring(alSayisi) + " / " + str.tostring(satSayisi), text_size = size.small)

    table.cell(ozet, 0, 6, "Puan", bgcolor = puanRengi, text_size = size.small)
    table.cell(ozet, 1, 6, str.tostring(puan) + "  " + etiket, bgcolor = puanRengi, text_size = size.small)

// --- Alarm koşulları --------------------------------------------------------
// TradingView'de: grafikte sağ tık → "Alarm ekle" → koşul olarak bu betiği
// ve aşağıdaki başlıklardan birini seç. Alarm TradingView sunucusunda
// çalışır; bilgisayarın kapalıyken de telefonuna bildirim düşer.
alertcondition(alYonuneGecti,  title = "Puan AL yönüne geçti",
     message = "{{ticker}} — sinyal puanı AL yönüne geçti ({{interval}})")
alertcondition(satYonuneGecti, title = "Puan SAT yönüne geçti",
     message = "{{ticker}} — sinyal puanı SAT yönüne geçti ({{interval}})")

alertcondition(kuralRsiSat, title = "RSI aşırı satım",
     message = "{{ticker}} — RSI aşırı satım bölgesinde ({{interval}})")
alertcondition(kuralRsiAl,  title = "RSI aşırı alım",
     message = "{{ticker}} — RSI aşırı alım bölgesinde ({{interval}})")

alertcondition(ta.crossover(macdCizgi, macdSinyalCizgi),  title = "MACD yukarı kesişim",
     message = "{{ticker}} — MACD sinyal çizgisini yukarı kesti ({{interval}})")
alertcondition(ta.crossunder(macdCizgi, macdSinyalCizgi), title = "MACD aşağı kesişim",
     message = "{{ticker}} — MACD sinyal çizgisini aşağı kesti ({{interval}})")

alertcondition(ta.crossover(smaHizliSeri, smaYavasSeri),  title = "Altın kesişim",
     message = "{{ticker}} — kısa SMA uzun SMA'yı yukarı kesti ({{interval}})")
alertcondition(ta.crossunder(smaHizliSeri, smaYavasSeri), title = "Ölüm kesişimi",
     message = "{{ticker}} — kısa SMA uzun SMA'yı aşağı kesti ({{interval}})")

alertcondition(kuralBbAlt, title = "Alt Bollinger bandı",
     message = "{{ticker}} — fiyat alt Bollinger bandında ({{interval}})")
alertcondition(kuralBbUst, title = "Üst Bollinger bandı",
     message = "{{ticker}} — fiyat üst Bollinger bandında ({{interval}})")
